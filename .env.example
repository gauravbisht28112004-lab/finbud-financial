# ─── Database ───────────────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/finbud

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret key for JWT tokens — change this to a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Admin Credentials ───────────────────────────────────────────────────────
# These are used by the seed script to create the first admin account
ADMIN_EMAIL=admin@finbudfinancial.com
ADMIN_PASSWORD=FinBud@Admin2025

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FinBud Financial

# ─── File Upload ─────────────────────────────────────────────────────────────
# Max file upload size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880
UPLOAD_DIR=public/uploads
